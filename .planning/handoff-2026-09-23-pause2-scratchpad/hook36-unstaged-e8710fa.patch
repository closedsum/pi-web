+// The fallback compares reviewed paths with the gated payload's own paths:
+// the prospective index of a compound add+commit, and the pushed range of a
+// push. Reading the real index instead sees nothing (compound) or the wrong
+// files (push).
+test('fallback measures the paths a compound add+commit stages', t => runCase(t.name, () => {
+  const repo = initRepo('sha-fallback-compound');
+  const files = ['src/one.js', 'src/two.js'];
+  for (const file of files) writeLines(repo, file, OVER_THRESHOLD, file);
+  plantManifest(repo, { staged_patch_sha256: 'a'.repeat(64), reviewed_paths: files });
+  assertAllowed(runHook(`git add -- ${files.join(' ')} && git commit -m "compound fallback"`, {
+    cwd: repo, toolName: 'Bash',
+  }), 'the fallback must see the prospectively staged paths');
+}, line => t.diagnostic(line)));
+
+test('fallback measures the pushed range, not the index', t => runCase(t.name, () => {
+  const { initRepoWithRemote, commitLines } = require('../../tests/commit-gate/helpers.cjs');
+  const repo = initRepoWithRemote('sha-fallback-push');
+  commitLines(repo, 'src/pushed.js', OVER_THRESHOLD, 'pushed change');
+  writeLines(repo, 'src/unrelated.js', 5, 'staged but not pushed');
+  git(repo, ['add', '--', 'src/unrelated.js']);
+  plantManifest(repo, { staged_patch_sha256: 'a'.repeat(64), reviewed_paths: ['src/pushed.js'] });
+  assertAllowed(runHook('git push', { cwd: repo }),
+    'the fallback must compare the pushed commits, not unrelated staged files');
+}, line => t.diagnostic(line)));
+
