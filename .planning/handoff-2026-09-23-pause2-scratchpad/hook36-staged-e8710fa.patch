+'use strict';
+
+// 92539bf removed two exemptions, and these cases pin the removal:
+// - the hook/test-source self-exemption: gate code is not exempt from its own
+//   review requirement;
+// - the GSD-only advisory fallback: quorum-unmet evidence never admits an
+//   over-threshold payload, GSD-owned or not.
