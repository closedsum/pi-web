+  git, writeLines, initRepo, _patchSha256,
+  runHook, assertBlocked, runCase,
+  NO_REVIEW_REASON, OVER_THRESHOLD, HALF, cleanup, fs, path,
+} = require('./helpers.cjs');
+
+const THIRD = Math.ceil(OVER_THRESHOLD / 3);
+const QUORUM_UNMET = /did not meet quorum .*Review quorum was attempted but unmet/;
+
+// A manifest genuinely bound to the staged change (staged_patch_sha256 is a
+// binding field the gate reads) whose review did not reach quorum.
+function plantQuorumUnmetManifest(repo) {
+  const manifestDir = path.join(repo, '.planning', 'research', 'review-test');
+  fs.mkdirSync(manifestDir, { recursive: true });
+  fs.writeFileSync(path.join(manifestDir, 'gsd-ar-manifest-test.json'), JSON.stringify({
+    slug: 'test', round: 1,
+    quorum: { met: false, selected: 3, reviewed: 1, min_reviewed: 3, min_fraction: 0.6 },
+    reviewers: { a: { outcome: 'reviewed', findings: 0 } },
