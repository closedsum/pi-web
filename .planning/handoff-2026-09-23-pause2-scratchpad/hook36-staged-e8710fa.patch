index 0000000..7a0ca57
--- /dev/null
+++ b/get-shit-done/tests/lib/commit-gate-sizes.cjs
@@ -0,0 +1,45 @@
+'use strict';
+
+// Commit-gate test payload sizes, derived from the hook's own review threshold so
+// a threshold change (2520c7b raised it 20 -> 200) can't silently turn a gated
+// case into an under-threshold pass. Requiring this module creates no fixtures.
+
+const path = require('node:path');
+
+const COMMIT_GATE_PATH = path.resolve(__dirname, '../../hooks/commit-gate.cjs');
+const { HARD_BLOCK_LINE_THRESHOLD: THRESHOLD } = require(COMMIT_GATE_PATH);
+if (!Number.isSafeInteger(THRESHOLD) || THRESHOLD <= 0) {
+  throw new Error(`commit-gate.cjs must export a positive HARD_BLOCK_LINE_THRESHOLD; got ${THRESHOLD}`);
+}
+
+// Comfortably over the threshold; HALF is half of it, so two halves are too.
+const OVER_THRESHOLD = THRESHOLD + 10;
+const HALF = Math.ceil(OVER_THRESHOLD / 2);
+
+// Fix-round fixtures: a seed file of SEED_LINES whose first REVIEWED_LINES
+// are rewritten for review. Each rewritten line is one deletion plus one
+// insertion, so the reviewed diff (2 * REVIEWED_LINES) exceeds the threshold,
+// and the seed keeps unreviewed lines after the rewritten region.
+const REVIEWED_LINES = Math.ceil(THRESHOLD / 2) + 5;
+const SEED_LINES = REVIEWED_LINES * 2;
+
+// The git-process weight for one commit-gate run's spawn budget
+// (hook-spawn.cjs spawnBudgetMs). Measured 12-65 git processes per run across
+// the gate suites; the fix-round push path is the heaviest (65).
+const COMMIT_GATE_GIT_PROCESSES = 70;
+const GATE_SPAWN_WEIGHT = Object.freeze({ gitProcesses: COMMIT_GATE_GIT_PROCESSES });
+
+// The deny text for an over-threshold payload with no review evidence. Use
+// NO_REVIEW_REASON when any line count is acceptable, and noReviewReason(n)
+// when the case knows the exact count and the count is part of what it checks.
+const NO_REVIEW_REASON = new RegExp(`\\d+ lines changed \\(threshold: ${THRESHOLD}\\)\\. ` +
+  'No recent cross-review found in \\.planning/research/');
+
+function noReviewReason(lines) {
+  return new RegExp(`\\b${lines} lines changed \\(threshold: ${THRESHOLD}\\)\\. No recent cross-review found`);
+}
+
+module.exports = {
+  COMMIT_GATE_PATH, THRESHOLD, OVER_THRESHOLD, HALF, REVIEWED_LINES, SEED_LINES,
+  COMMIT_GATE_GIT_PROCESSES, GATE_SPAWN_WEIGHT, NO_REVIEW_REASON, noReviewReason,
+};
