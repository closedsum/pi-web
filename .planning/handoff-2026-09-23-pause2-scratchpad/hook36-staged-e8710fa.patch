+  plantQuorumUnmetManifest(repo);
+  assertBlocked(runHook('git commit -m "mixed gsd and app"', { cwd: repo }), QUORUM_UNMET,
+    'mixed GSD + non-GSD payload must not be admitted by quorum-unmet evidence');
+}, line => t.diagnostic(line)));
+
+after(cleanup);
