--- /dev/null
+++ b/get-shit-done/tests/lib/hermetic-hook-env.cjs
@@ -0,0 +1,49 @@
+'use strict';
+
+// One sandboxed environment for GSD hooks in tests, and for every git call a
+// suite makes (so fixture git and the hook read the same config): HOME, USERPROFILE,
+// GSD_HOME, GSD_STATE_HOME and the review-history search path all point under
+// `root`, and every other inherited GSD_* variable is dropped, so neither the
+// developer's live ~/.gsd, ~/.gsd-state (review history, review receipts) nor a
+// GSD_* setting in their shell (e.g. GSD_COMMIT_GATE_MANIFEST_CHECK) can decide
+// a test. A case that needs a GSD_* value passes it through `overrides`.
+
+const fs = require('node:fs');
+const path = require('node:path');
+
+const prepared = new Set();
+
+function hermeticHookEnv(root, overrides = {}) {
+  const home = path.join(root, 'home');
+  const gsdHome = path.join(root, 'gsd-home');
+  const stateHome = path.join(root, 'state-home');
+  if (!prepared.has(root)) {
+    for (const dir of [
+      path.join(home, '.gsd', 'review-history'),
